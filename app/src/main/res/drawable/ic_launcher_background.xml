    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Obsidian Black Layer -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#0A0103" />

    <!-- Dark Crimson Radial Energy Core -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="60"
                android:type="radial">
                <item android:color="#5A0813" android:offset="0.0" />
                <item android:color="#30030A" android:offset="0.5" />
                <item android:color="#0D0103" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Geometric Hexagon Stealth Ring in Background -->
    <path
        android:pathData="M54,18 L84,35 L84,71 L54,88 L24,71 L24,35 Z"
        android:strokeWidth="1"
        android:strokeColor="#1AFF1744"
        android:fillColor="#00000000" />

    <!-- Center Crimson Aura Spotlight -->
    <path
        android:pathData="M54,20 A34,34 0 1,0 54,88 A34,34 0 1,0 54,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34"
                android:type="radial">
                <item android:color="#33FF1744" android:offset="0.0" />
                <item android:color="#00FF1744" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
